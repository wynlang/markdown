// Exercises the shipped lib in src/markdown.wyn via the tests/markdown.wyn symlink.
import markdown

test "bold" { assert_eq(markdown.md_bold("x"), "<strong>x</strong>") }
test "italic" { assert_eq(markdown.md_italic("x"), "<em>x</em>") }
test "heading" { assert_eq(markdown.md_heading(2, "Title"), "<h2>Title</h2>") }
test "link" { assert_eq(markdown.md_link("Docs", "https://w.com"), "<a href=\"https://w.com\">Docs</a>") }
test "code" { assert_eq(markdown.md_code("x"), "<code>x</code>") }
test "list item" { assert_eq(markdown.md_list_item("a"), "<li>a</li>") }
test "paragraph" { assert_eq(markdown.md_paragraph("p"), "<p>p</p>") }
